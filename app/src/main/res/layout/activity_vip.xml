<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1A0E">

    <!-- ============================================================ -->
    <!--   KONTEN UTAMA — ScrollView berhenti di atas navbar          -->
    <!-- ============================================================ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavBar"
        android:background="#0E1A0E"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== HERO IMAGE ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/imgRoom"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/vip" />

                <!-- Overlay gelap bawah -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_image_overlay" />

                <!-- Badge VIP + rating di kiri bawah foto -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="VIP Room"
                        android:textColor="#D4AF37"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.8"
                            android:textColor="#E8D48A"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#6B6040" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1k+ Tersewa"
                            android:textColor="#9A832A"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Harga di kanan bawah foto -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_badge_gold"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 90.000"
                        android:textColor="#1A1A0A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="per jam"
                        android:textColor="#1A1A0A"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== KONTEN UTAMA ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ─── Info Card ─── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_form_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Lokasi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/location"
                            app:tint="#D4AF37" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.10"
                                android:text="LOKASI"
                                android:textColor="#9A832A"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Jl. Gajah Mada no.541, Kuta, Bali"
                                android:textColor="#E8D48A"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="#2A2A18" />

                    <!-- Jam Buka -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/clock"
                            app:tint="#D4AF37" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.10"
                                android:text="JAM BUKA"
                                android:textColor="#9A832A"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOpenHours"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="10.00 – 23.00"
                                android:textColor="#E8D48A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Status Buka -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_open"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/ball_yellow" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Buka"
                                android:textColor="#D4AF37"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ─── Pilih Nomor Meja ─── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:background="#D4AF37" />

                    <TextView
                        android:id="@+id/tvTableNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:letterSpacing="0.08"
                        android:text="PILIH NOMOR MEJA"
                        android:textColor="#D4AF37"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="Ketuk nomor meja yang ingin dipesan"
                    android:textColor="#4A4730"
                    android:textSize="11sp" />

                <!-- ─── Grid Meja ─── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_form_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <Button android:id="@+id/btn11" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="1" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                        <Button android:id="@+id/btn12" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="2" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                        <Button android:id="@+id/btn13" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="3" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                        <Button android:id="@+id/btn14" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="4" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                        <Button android:id="@+id/btn15" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="5" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                    </LinearLayout>

                    <!-- Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button android:id="@+id/btn16" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="6" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                        <Button android:id="@+id/btn17" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="7" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                        <Button android:id="@+id/btn18" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="8" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                        <Button android:id="@+id/btn19" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="9" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                        <Button android:id="@+id/btn20" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_table_btn" android:text="10" android:textColor="#D4AF37" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@null" />
                    </LinearLayout>

                    <!-- Legenda -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_table_btn" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="16dp"
                            android:text="Tersedia"
                            android:textColor="#4A4730"
                            android:textSize="10sp" />

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_table_selected" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="16dp"
                            android:text="Dipilih"
                            android:textColor="#4A4730"
                            android:textSize="10sp" />

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_table_booked" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Terpesan"
                            android:textColor="#4A4730"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ─── Tombol Reserve ─── -->
                <Button
                    android:id="@+id/btnReserve"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_button_gold"
                    android:elevation="4dp"
                    android:letterSpacing="0.15"
                    android:text="RESERVASI SEKARANG"
                    android:textColor="#1A1A0A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Bola dekorasi -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/ball_red" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/ball_yellow" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/ball_black" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/ball_yellow" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/ball_red" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============================================================ -->
    <!--   BOTTOM NAVIGATION BAR — fixed di paling bawah layar       -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="#1A2A1A"
        android:elevation="12dp"
        android:orientation="horizontal">

        <!-- ── TAB HOME ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="#4A5A3A" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="#4A5A3A"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- ── TAB RESERVATIONS (aktif) ────────────────────────── -->
        <LinearLayout
            android:id="@+id/navReservations"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Lingkaran highlight aktif -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <!-- Background bulat emas redup -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_nav_active" />

                <ImageView
                    android:id="@+id/iconReservations"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_reservation"
                    app:tint="#D4AF37" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Reservations"
                android:textColor="#D4AF37"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── TAB INFO ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/navInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/iconInfo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info"
                    app:tint="#4A5A3A" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Info"
                android:textColor="#4A5A3A"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- ── TAB PROFIL ──────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/iconProfil"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile"
                    app:tint="#4A5A3A" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profil"
                android:textColor="#4A5A3A"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>